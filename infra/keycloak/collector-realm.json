{
  "realm": "collector",
  "displayName": "Collector.shop",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "roles": {
    "realm": [
      {
        "name": "acheteur",
        "description": "Peut acheter, noter et suivre ses achats"
      },
      {
        "name": "vendeur",
        "description": "Peut mettre des articles en vente"
      },
      {
        "name": "admin",
        "description": "Back-office : catégories, modération"
      }
    ]
  },
  "clients": [
    {
      "clientId": "collector-web",
      "name": "Front Collector (SPA Vue)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://collector.local/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##https://collector.local/*"
      },
      "protocolMappers": [
        {
          "name": "audience-catalogue-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "catalogue-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-notification-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "notification-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "collector-tests",
      "name": "Tests d'acceptation (DEV UNIQUEMENT)",
      "description": "Flux mot de passe pour les tests automatisés. A supprimer du realm de production.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-catalogue-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "catalogue-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-notification-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "notification-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "vendeur1",
      "email": "vendeur1@collector.local",
      "emailVerified": true,
      "firstName": "Vendeur",
      "lastName": "Un",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KC_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "acheteur",
        "vendeur"
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "vendeur2",
      "email": "vendeur2@collector.local",
      "emailVerified": true,
      "firstName": "Vendeur",
      "lastName": "Deux",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KC_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "acheteur",
        "vendeur"
      ]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "acheteur1",
      "email": "acheteur1@collector.local",
      "emailVerified": true,
      "firstName": "Acheteur",
      "lastName": "Un",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KC_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "acheteur"
      ]
    },
    {
      "id": "44444444-4444-4444-8444-444444444444",
      "username": "admin",
      "email": "admin@collector.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Collector",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KC_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
