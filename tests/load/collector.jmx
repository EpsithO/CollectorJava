me="Header.value">Bearer ${__P(token_vendeur2)}</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Code attendu" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp><stringProp name="1">409</stringProp><stringProp name="2">429</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">40</intProp></ResponseAssertion><hashTree></hashTree></hashTree></hashTree></hashTree><JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Arrêt si erreurs &gt; 5 %" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def total = props.get("guard_total") ?: new java.util.concurrent.atomic.AtomicLong()
def errors = props.get("guard_errors") ?: new java.util.concurrent.atomic.AtomicLong()
props.put("guard_total", total); props.put("guard_errors", errors)
// 429 = protection du rate limiting (voir README) : pas une erreur de l'application
def n = total.incrementAndGet()
if (!prev.isSuccessful() &amp;&amp; prev.getResponseCode() != "429") { errors.incrementAndGet() }
if (n &gt;= 200 &amp;&amp; errors.get() * 100.0 / n &gt; 5.0) {
  log.error("Erreurs &gt; 5 % (" + errors.get() + "/" + n + ") : arrêt du test")
  ctx.getEngine().askThreadsToStop()
}</stringProp></JSR223Listener><hashTree></hashTree></hashTree></hashTree></hashTree></jmeterTestPlan>
