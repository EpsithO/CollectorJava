# Valeurs de développement (compose). Copier en .env.local pour les changer ; aucun secret ici :
# le front est un client public OIDC (Authorization Code + PKCE).
VITE_API_URL=http://localhost:8080
VITE_NOTIFICATION_URL=http://localhost:8082
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/collector
VITE_OIDC_CLIENT_ID=collector-web
